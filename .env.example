MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>/<db_name>?retryWrites=true&w=majority
MONGODB_DB_NAME=internship

AUTH_SECRET=replace_with_long_random_secret
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
# Optional: native client IDs for the mobile-native-token endpoint
# GOOGLE_ANDROID_CLIENT_ID=replace_with_android_client_id
# GOOGLE_IOS_CLIENT_ID=replace_with_ios_client_id

CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
NEXTAUTH_URL=http://localhost:3000
